{
	"name": "joey/website",
	"description": "Personal website application.",
	"license": "proprietary",
	"require": {
		"php": ">=8.0.0",
		"zeuxisoo/slim-whoops": "0.7.*",
		"illuminate/database": "^13.25",
		"monolog/monolog": "^3.10",
		"scssphp/scssphp": "^2.1",
		"mailgun/mailgun-php": "^4.5",
		"vlucas/phpdotenv": "^5.6",
		"delight-im/cookie": "^3.1.2",
		"matthiasmullie/minify": "^1.3",
		"middlewares/whoops": "^2.0.2",
		"respect/validation": "^2.5",
		"ramsey/uuid": "^4.2.3",
		"twig/twig": "^3.28",
		"slim/slim": "^4.15.2",
		"slim/csrf": "^1.5",
		"slim/flash": "^0.4.0",
		"php-http/curl-client": "^2.3",
		"guzzlehttp/psr7": "^3.0",
		"jwilsson/spotify-web-api-php": "^7.2",
		"slim/psr7": "^1.5",
		"slim/twig-view": "^3.2",
		"php-di/php-di": "^7.1"
	},
	"autoload": {
		"classmap": [
			"app/controllers",
			"app/middleware",
			"app/models",
			"app/validation"
		],
		"files": [
			"app/helpers.php"
		]
	},
	"scripts": {
		"test": "php -c php.ini.testing vendor/bin/pest --colors=always",
		"test:pest": "php -c php.ini.testing vendor/bin/pest --colors=always",
		"test:phpunit": "php -c php.ini.testing vendor/bin/phpunit --configuration phpunit.xml",
		"test:coverage": "phpdbg -qrr -c php.ini.testing vendor/bin/phpunit --configuration phpunit.xml --coverage-text --coverage-clover build/coverage/clover.xml --coverage-html build/coverage/html",
		"test:coverage:gate": "phpdbg -qrr -c php.ini.testing vendor/bin/phpunit --configuration phpunit.xml --coverage-clover build/coverage/clover.xml && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/check-coverage.ps1 -Clover build/coverage/clover.xml -Minimum 25"
	},
	"require-dev": {
		"phpunit/phpunit": "^12.5",
		"pestphp/pest": "^4.7"
	},
	"config": {
		"platform": {
			"php": "8.3.30"
		},
		"allow-plugins": {
			"php-http/discovery": true,
			"pestphp/pest-plugin": true
		}
	}
}
