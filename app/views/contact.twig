{% extends 'layout.twig' %}
{% block body %}

{% include 'error.twig' %}

<section id="contact">
	<div class="container">
		<div class="row center-xs center-sm left-text">
			<div class="col-xs-11 col-sm-11 col-md-5 col-lg-5">
				<h1>Contact</h1>
				<p>Please fill out the form so I can learn more about you, your company and your needs.</p>
				{# <p><pre>{{ data | json_encode }}</pre></p> #}
			</div>

			<div class="col-xs-11 col-sm-11 col-md-6 col-lg-6 col-md-offset-1 col-lg-offset-1">
				<form accept-charset="UTF-8" method="post" enctype="multipart/form-data" action="{{ url_for('contact-post', {'hash': backend.post_request_obfuscation_hash}) }}" autocomplete="off" novalidate>
					<input type="hidden" name="{{ csrf.name_key }}" value="{{ csrf.name }}">
					<input type="hidden" name="{{ csrf.value_key }}" value="{{ csrf.value }}">

					{% if form_errors is not empty %}
						<div class="alert alert-danger" id="contact-form-errors" role="alert" aria-labelledby="contact-form-errors-title">
							<strong id="contact-form-errors-title">Please correct the highlighted fields and try again.</strong>
						</div>
					{% endif %}

					{# <input type="text" name="{{ backend.post_request_obfuscation_hash }}" tabindex="-1" value="{{ backend.post_request_obfuscation_hash }}">
					<input type="text" name="{{ backend.post_request_ready_at }}" tabindex="-1" value="{{ backend.post_request_ready_at }}"> #}

					{# NAME AND ORGNAME #}
					<div class="row form-group">
						<div class="half left">
							<div class="input-section {% if form_errors.name is defined %} error {% endif %}">
								<label for="name">Your full name</label>
								{% if form_errors.name is defined %}
									<div class="error" id="name-error">{{ form_errors.name | first }}</div>
								{% endif %}
								<input id="name" type="text" name="name" placeholder="John Doe" autocomplete="name" required{% if form_errors.name is defined %} aria-invalid="true" aria-describedby="name-error"{% endif %}{% if old_form_data.name is defined %} value="{{ old_form_data.name }}"{% endif %} title="What's your name?">
							</div>
						</div>

						<div class="half right">
							<div class="input-section {% if form_errors.orgname is defined %} error {% endif %}">
								<label for="orgname">Your organization name</label>
								{% if form_errors.orgname is defined %}
									<div class="error" id="orgname-error">{{ form_errors.orgname | first }}</div>
								{% endif %}
								<input id="orgname" type="text" name="orgname" placeholder="Organization Name" autocomplete="organization" required{% if form_errors.orgname is defined %} aria-invalid="true" aria-describedby="orgname-error"{% endif %}{% if old_form_data.orgname is defined %} value="{{ old_form_data.orgname }}"{% endif %} title="What's your organization name?">
							</div>
						</div>
					</div>

					{# PHONE AND EMAIL #}
					<div class="row form-group">
						<div class="half left">
							<div class="input-section {% if form_errors.phone is defined %} error {% endif %}">
								<label for="phone">Your phone number</label>
								{% if form_errors.phone is defined %}
									<div class="error" id="phone-error">{{ form_errors.phone | first }}</div>
								{% endif %}
								<input id="phone" type="tel" name="phone" placeholder="Phone Number" autocomplete="tel" required{% if form_errors.phone is defined %} aria-invalid="true" aria-describedby="phone-error"{% endif %}{% if old_form_data.phone is defined %} value="{{ old_form_data.phone }}"{% endif %} title="What's your phone number?">
							</div>
						</div>
						<div class="half right">
							<div class="input-section {% if form_errors.email is defined %} error {% endif %}">
								<label for="email">Your email address</label>
								{% if form_errors.email is defined %}
									<div class="error" id="email-error">{{ form_errors.email | first }}</div>
								{% endif %}
								<input id="email" type="email" name="email" placeholder="Email Address" autocomplete="email" required{% if form_errors.email is defined %} aria-invalid="true" aria-describedby="email-error"{% endif %}{% if old_form_data.email is defined %} value="{{ old_form_data.email }}"{% endif %} title="What's your email address?">
							</div>
						</div>
					</div>

					{# LOCATION AND WHAT #}
					<div class="row form-group">
						<div class="half left">
							<div class="input-section {% if form_errors.location is defined %} error {% endif %}">
								<label for="location">Your location</label>
								{% if form_errors.location is defined %}
									<div class="error" id="location-error">{{ form_errors.location | first }}</div>
								{% endif %}
								<input id="location" type="text" name="location" placeholder="Where are you located?" autocomplete="address-level2" required{% if form_errors.location is defined %} aria-invalid="true" aria-describedby="location-error"{% endif %}{% if old_form_data.location is defined %} value="{{ old_form_data.location }}"{% endif %} title="Where are you located?">
							</div>
						</div>
						<div class="half right">
							<div class="input-section {% if form_errors.what is defined %} error {% endif %}">
								<label for="what">What can we help you with?</label>
								{% if form_errors.what is defined %}
									<div class="error" id="what-error">{{ form_errors.what | first }}</div>
								{% endif %}
								<input id="what" type="text" name="what" placeholder="What can we help you with?" autocomplete="off" required{% if form_errors.what is defined %} aria-invalid="true" aria-describedby="what-error"{% endif %}{% if old_form_data.what is defined %} value="{{ old_form_data.what }}"{% endif %} title="What can we help you with?">
							</div>
						</div>
					</div>

					{# FREE-HAND TEXT #}
					<div class="row form-group">
						<div class="input-section {% if form_errors.message is defined %} error {% endif %}">
							<label for="message">Your message</label>
							{% if form_errors.message is defined %}
								<div class="error" id="message-error">{{ form_errors.message | first }}</div>
							{% endif %}
							<textarea id="message" cols="30" rows="5" name="message" class="noresize" placeholder="Tell me a bit about your project, timeline, and budget" autocomplete="off" required{% if form_errors.message is defined %} aria-invalid="true" aria-describedby="message-error"{% endif %}>{{ old_form_data.message }}</textarea>
						</div>
					</div>

					{# SPAM CHECK #}
					<div class="form-group" style="display:none;">
						<div class="input-section" style="position: absolute; left: -5000px;" aria-hidden="true">
							<input type="text" name="_honey" tabindex="-1" value="">
							<input type="text" name="abstraction" tabindex="-1" value="other-form">
						</div>
					</div>

					<div class="row form-group">
						<button type="submit" class="btn blue shadow">Send message</button>
					</div>
				</form>
			</div>
		</div>
	</div>
</section>
{% endblock %}
