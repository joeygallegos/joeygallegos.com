<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         cacheDirectory=".phpunit.cache"
         colors="true"
         failOnDeprecation="false">
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
    </testsuites>

    <source>
        <include>
            <file>app/controllers/BaseController.php</file>
            <file>app/controllers/ContactController.php</file>
            <file>app/controllers/SiteListenerController.php</file>
            <file>app/middleware/FormValidation/CheckFormSpam.php</file>
            <file>app/validation/Validator.php</file>
        </include>
    </source>

    <coverage includeUncoveredFiles="true"/>

    <php>
        <ini name="error_reporting" value="E_ALL &amp; ~E_DEPRECATED &amp; ~E_USER_DEPRECATED"/>
    </php>
</phpunit>
